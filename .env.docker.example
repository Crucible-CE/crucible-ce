# Crucible CE docker compose configuration. Copy to .env and fill in secrets:
#   cp .env.docker.example .env
#
# Generate each secret with: openssl rand -hex 32
# The app refuses to boot with a placeholder, a NEXTAUTH_SECRET shorter than
# 32 chars, or a MASTER_KEK that is not 32 bytes (64 hex chars) / all zeros.

# REQUIRED ------------------------------------------------------------------
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
# Encrypts evidence and sensitive fields at rest. Losing it makes that data
# unrecoverable; store it with your backups.
MASTER_KEK=

# RECOMMENDED ---------------------------------------------------------------
# The URL your team will use (behind your reverse proxy / TLS).
PUBLIC_URL=http://localhost:3000
# Host port to expose the app on.
CRUCIBLE_PORT=3000
# Trusted reverse proxies in front of the app. 0 (default) = reached directly;
# X-Forwarded-For / X-Real-IP are ignored because clients can forge them.
# Set 1 behind a single reverse proxy (Caddy / nginx / Traefik); one more per
# extra hop that appends to X-Forwarded-For (e.g. CDN -> proxy = 2).
# REQUIRED behind a proxy: at 0 every client shares the proxy's IP and so one
# rate-limit bucket (sign-in, setup, password reset).
TRUSTED_PROXY_HOPS=0
# Extra origins (comma-separated) allowed to open a Socket.io connection,
# besides PUBLIC_URL. Usually empty.
SOCKET_EXTRA_ALLOWED_ORIGINS=

# OPTIONAL: email (member invites, verification, email paging) --------------
# Any SMTP server (wins when set) ...
SMTP_HOST=
SMTP_PORT=
# true = implicit TLS (port 465); otherwise STARTTLS
SMTP_SECURE=
# STARTTLS is required for every host except localhost/127.0.0.1/::1 (blank).
# false = allow plaintext (a trusted relay without TLS, e.g. a mailpit container)
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASS=
# Sender; falls back to FROM_EMAIL
SMTP_FROM=
# ... or Resend
RESEND_API_KEY=
FROM_EMAIL=
# Force smtp | resend when both are set
EMAIL_PROVIDER=

# OPTIONAL: SMS + voice paging (bring your own Twilio) -----------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# true once the number's Messaging webhook points at
# https://<PUBLIC_URL>/api/public/twilio/inbound (reply ACK to acknowledge)
TWILIO_INBOUND_ACK=

# OPTIONAL: signed paging webhook(s) (docs/delivery-providers.md) ------------
# One URL or a comma-separated list; the secret is required (openssl rand -hex 32)
DELIVERY_WEBHOOK_URL=
DELIVERY_WEBHOOK_SECRET=
DELIVERY_WEBHOOK_URL_2=
DELIVERY_WEBHOOK_SECRET_2=
DELIVERY_WEBHOOK_URL_3=
DELIVERY_WEBHOOK_SECRET_3=
# More targets: DELIVERY_WEBHOOK_URL_4 .. _9 (and DELIVERY_WEBHOOK_SECRET_4 .. _9)
# are passed through by docker-compose.yml too.
# true ONLY for local testing: lets webhooks + plugins reach localhost / private IPs and http:// URLs
DELIVERY_WEBHOOK_ALLOW_PRIVATE=

# OPTIONAL: delivery tuning (defaults shown when blank) ----------------------
# Retry delays in minutes after a failed delivery attempt (0 = no retries)
DELIVERY_RETRY_BACKOFF_MINUTES=1,5,15
# Anti toll-fraud: SMS (and, separately, voice) per phone number per hour (default 10;
# escalations and critical pages exempt; a throttled send is retried later)
DELIVERY_RATE_LIMIT_PER_RECIPIENT_HOUR=
# Anti toll-fraud: SMS (and, separately, voice) per organization per hour (default 100)
DELIVERY_RATE_LIMIT_PER_ORG_HOUR=
# Abuse ceiling per phone number per hour, escalations and critical pages included (default 60)
DELIVERY_RATE_LIMIT_PER_NUMBER_CEILING_HOUR=
# Lifetime of the signed acknowledge link in hours (default 24)
DELIVERY_ACK_LINK_TTL_HOURS=

# OPTIONAL: custom delivery providers -----------------------------------------
# Plugins load from ./providers (mounted read-only at /app/providers). They run
# with the app's full privileges: install only code you trust.
# The example plugin (providers/example-ntfy.mjs) is enabled by NTFY_TOPIC.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# OPTIONAL: signed case-file exports and after-action reports (Ed25519 private key, base64)
EXPORT_SIGNING_PRIVATE_KEY=

# OPTIONAL: Crucible Cloud trial sign-up link (unset shows "Coming soon") -----
CLOUD_TRIAL_URL=

# OPTIONAL: most guests (invite code joiners) one exercise takes (default 60)
GUEST_CAP_PER_EXERCISE=

# OPTIONAL: uploads + storage ------------------------------------------------
# Max size of one evidence / attachment upload in bytes (default 104857600 = 100 MB)
MAX_ATTACHMENT_BYTES=
# Uploads processed at once per process (default 4); more get 503 + Retry-After
MAX_CONCURRENT_UPLOADS=
# S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO / Backblaze B2)
# instead of the uploads volume. Leave STORAGE_S3_BUCKET blank for local disk.
STORAGE_S3_BUCKET=
# Defaults to us-east-1
STORAGE_S3_REGION=
STORAGE_S3_PREFIX=
# Set for R2 / MinIO / B2 (path-style)
STORAGE_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# OPTIONAL: other ------------------------------------------------------------
# Salt for hashing client IPs in the activity log (unset = IPs not recorded)
ACTIVITY_IP_SALT=
# true = closing an incident requires a FINAL postmortem, not just a draft
FEATURE_CLOSURE_REQUIRE_FINAL_POSTMORTEM=
# Country calling code for phone numbers entered without "+" (default 1)
PHONE_DEFAULT_COUNTRY_CODE=
