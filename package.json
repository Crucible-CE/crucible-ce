{
  "name": "crucible-ce",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Internal-Use-1.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:ws": "tsx server-socket.ts",
    "dev:full": "concurrently --names \"NEXT,WS  \" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"npm:dev\" \"npm:dev:ws\"",
    "build": "next build",
    "prod:build": "npm run db:generate && npm run build",
    "prod:migrate": "prisma migrate deploy",
    "prod:start": "prisma generate && tsx -e \"process.env.NODE_ENV='production'; import('./server.ts')\"",
    "prod": "npm run prod:build && npm run prod:migrate && npm run prod:start",
    "start": "npm run prod:start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "depcheck": "depcheck",
    "verify-export": "tsx scripts/verify-export.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:report": "playwright show-report",
    "e2e:up": "tsx e2e/stack.ts up",
    "e2e:down": "tsx e2e/stack.ts down",
    "provider:test": "tsx scripts/provider-test.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "verify-bundle": "tsx scripts/verify-bundle.ts",
    "library:playbooks": "tsx scripts/gen-library-playbooks.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@prisma/client": "^6.9.0",
    "@react-pdf/renderer": "^4.3.2",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "docx": "^9.14.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.25",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.6.1",
    "pdfjs-dist": "^6.5.438",
    "prisma": "^6.19.3",
    "qrcode": "1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^5.11.0",
    "resend": "^6.10.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.19.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "depcheck": "^1.4.7",
    "esbuild": "^0.28.1",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.4.0",
    "jsdom": "^29.0.1",
    "knip": "^5.46.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.1"
  },
  "overrides": {
    "@auth/core": {
      "nodemailer": "$nodemailer",
      "@simplewebauthn/browser": "$@simplewebauthn/browser",
      "@simplewebauthn/server": "$@simplewebauthn/server"
    },
    "next": {
      "postcss": "^8.5.30"
    },
    "deepmerge-ts": "^8.0.2",
    "next-auth": {
      "nodemailer": "$nodemailer",
      "@simplewebauthn/browser": "$@simplewebauthn/browser",
      "@simplewebauthn/server": "$@simplewebauthn/server"
    },
    "effect": "^3.22.5"
  }
}
