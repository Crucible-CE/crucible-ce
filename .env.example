# ===========================================================================
# Crucible CE environment template. Copy to .env.local for local dev.
# The docker-compose install sets all required values for you; this file is
# for running from source. NEVER commit a real .env file.
# ===========================================================================

# --- Database (Postgres; pooled + direct URLs) ------------------------------
# With the dev stack (`npm run db:up`): pooled via PgBouncer, direct for
# migrations. A plain single Postgres can use the same URL for both.
DATABASE_URL="postgresql://crucible:crucible@127.0.0.1:6432/crucible?pgbouncer=true&connection_limit=20"
DIRECT_URL="postgresql://crucible:crucible@127.0.0.1:5432/crucible"

# --- Auth -------------------------------------------------------------------
# Generate secrets with: openssl rand -base64 32
# The server (server.ts) and the dev socket sidecar (npm run dev:ws / dev:full)
# REFUSE TO BOOT while these are still placeholders or shorter than 32 chars.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# --- Encryption at rest (AES-256-GCM for sensitive columns + evidence) ------
# openssl rand -hex 32 . Loss of this key makes encrypted data unreadable.
# Must decode to 32 bytes (64 hex chars or base64); never all zeros in production.
MASTER_KEK="generate-with-openssl-rand-hex-32"

# --- Client IP / reverse proxy ----------------------------------------------
# How many trusted reverse proxies sit in front of the app. Default 0: the app
# is reached directly and X-Forwarded-For / X-Real-IP are IGNORED (a client can
# set them). Set 1 behind a single reverse proxy (Caddy, nginx, Traefik); add
# one per further hop that appends to X-Forwarded-For (e.g. CDN -> proxy = 2).
# REQUIRED behind a proxy, or every client shares one rate-limit bucket.
# TRUSTED_PROXY_HOPS=0
# Extra comma-separated origins allowed to open a Socket.io connection.
# SOCKET_EXTRA_ALLOWED_ORIGINS=

# --- Realtime ---------------------------------------------------------------
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
REDIS_URL="redis://localhost:6379"

# --- Email (optional but recommended: invites, verification, email paging) --
# PUBLIC_URL=https://crucible.yourdomain.com   # absolute links in emails + ack links
# SMTP works with any mail server. For local testing use the Mailpit catcher
# from `npm run db:up`: SMTP_HOST=localhost SMTP_PORT=1025, inbox at http://localhost:8025
# SMTP_HOST=
# SMTP_PORT=587                     # 465 when SMTP_SECURE=true
# SMTP_SECURE=false                 # true = implicit TLS (465); otherwise STARTTLS
# SMTP_REQUIRE_TLS=                 # default: STARTTLS required except for localhost/127.0.0.1/::1; false = allow plaintext
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Crucible <pager@yourdomain.com>"   # falls back to FROM_EMAIL
# Or Resend (used when SMTP_HOST is unset):
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@yourdomain.com
# EMAIL_PROVIDER=smtp               # force smtp | resend when both are configured

# --- Out-of-band paging (optional; channels skip honestly when unset) -------
# See docs/paging.md and docs/delivery-providers.md.
# Twilio SMS + voice. With an https PUBLIC_URL, calls offer "press 1 to
# acknowledge" and delivery-status callbacks turn on.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_INBOUND_ACK=true           # after pointing the number's Messaging webhook at /api/public/twilio/inbound
#
# Signed generic webhook(s): JSON POST with an HMAC-SHA256 signature.
# DELIVERY_WEBHOOK_URL=https://hooks.example.com/crucible   # or a comma-separated list
# DELIVERY_WEBHOOK_SECRET=          # required; openssl rand -hex 32
# DELIVERY_WEBHOOK_URL_2=           # more targets (_2, _3, ... any N); DELIVERY_WEBHOOK_SECRET_N overrides the secret
# DELIVERY_WEBHOOK_ALLOW_PRIVATE=false   # true ONLY for local testing (allows localhost/private IPs and http://)
#
# Delivery engine tuning (defaults shown)
# DELIVERY_RETRY_BACKOFF_MINUTES=1,5,15        # retry delays after a failed attempt (0 = no retries)
# DELIVERY_RATE_LIMIT_PER_RECIPIENT_HOUR=10    # SMS (and, separately, voice) per number per hour; escalations + critical exempt
# DELIVERY_RATE_LIMIT_PER_ORG_HOUR=100         # SMS (and, separately, voice) per organization per hour
# DELIVERY_RATE_LIMIT_PER_NUMBER_CEILING_HOUR=60   # abuse ceiling per number per hour (escalations/critical included)
# DELIVERY_ACK_LINK_TTL_HOURS=24               # lifetime of the signed acknowledge link
#
# Custom delivery providers (plugins). Default: ./providers. Plugins run with
# the app's full privileges; install only code you trust.
# PROVIDERS_DIR=./providers
# NTFY_TOPIC=                       # enables the example plugin providers/example-ntfy.mjs

# --- Evidence + case-file export storage ------------------------------------
# Local filesystem by default; mount a volume in production.
# EVIDENCE_DIR=./uploads/evidence
# EXPORT_DIR=./uploads/exports
# STORAGE_DIR=./uploads/documents
# Max size of ONE evidence / task-attachment upload (default 100 MB when unset);
# larger bodies are refused before they are read into memory.
MAX_ATTACHMENT_BYTES=26214400       # 25 MB
# Uploads processed at once per process (default 4); beyond it -> 503 + Retry-After.
# MAX_CONCURRENT_UPLOADS=4
# S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO / Backblaze B2):
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_PREFIX=
# STORAGE_S3_ENDPOINT=              # set for R2/MinIO (path-style)
# AWS_ACCESS_KEY_ID=                # S3 credentials (standard AWS SDK variables)
# AWS_SECRET_ACCESS_KEY=

# --- Signed case-file exports (optional; export signing disabled when unset) -
# Ed25519 private key, base64. Also signs after-action reports. See
# docs/case-file-exports.md.
# EXPORT_SIGNING_PRIVATE_KEY=

# --- Crucible Cloud (optional) ------------------------------------------------
# Trial sign-up link for the Cloud page and the Cloud notes. Unset keeps
# "Coming soon". CE never connects to Cloud.
# CLOUD_TRIAL_URL=

# --- Other optional settings -------------------------------------------------
# ACTIVITY_IP_SALT=                 # salt for hashing client IPs in the activity log (unset = not recorded)
# FEATURE_CLOSURE_REQUIRE_FINAL_POSTMORTEM=true   # closing needs a FINAL postmortem, not a draft
# PHONE_DEFAULT_COUNTRY_CODE=1      # calling code for numbers entered without "+"
