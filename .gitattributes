# Normalize line endings to LF in the repo regardless of OS checkout.
* text=auto eol=lf

# Shell scripts must stay LF or they break on Linux CI and in the image.
*.sh text eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
